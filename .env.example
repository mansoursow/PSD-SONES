# --- Stockage (obligatoire en ligne) : Vercel > Storage > Upstash for Redis (crée ces variables automatiquement)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- E-mails : soit Resend (recommandé)…
RESEND_API_KEY=
MAIL_FROM="PSD SONES 2026-2030 <entretiens@votre-domaine.sn>"
# …soit SMTP (ex. Gmail avec un mot de passe d'application)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Adresse du consultant mise en copie de chaque confirmation / annulation
CONSULTANT_EMAIL=

# URL publique du site (utilisée dans les liens des e-mails)
SITE_URL=

# Code d'accès commun aux structures (optionnel mais recommandé) et mot de passe de l'espace consultant
ACCESS_CODE=
ADMIN_PASSWORD=

# Période de réservation (AAAA-MM-JJ) et lieu par défaut
BOOKING_START=
BOOKING_END=
MEETING_PLACE="Siège de la SONES, Dakar"
